{
  "name": "dsh-token-tally",
  "version": "0.2.0",
  "description": "Token 台账 — DeepSeek Harness (DSH) 用量与费用看板插件：六页签消耗视图、缓存命中趋势、日/周/累计活动、模型/供应商/项目多维排行、会话明细与模型对比，本地聚合 Token 和预估费用，零第三方运行时依赖。/ Token & cost dashboard for DeepSeek Harness: six usage views, cache-hit trends, daily/weekly/cumulative activity, model/provider/project rankings, per-session details and model comparison — aggregated locally, zero third-party runtime deps.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "token",
    "tokens",
    "token-usage",
    "usage",
    "usage-dashboard",
    "cost",
    "cost-dashboard",
    "cost-tracking",
    "llm-usage",
    "model-comparison",
    "analytics",
    "dashboard",
    "heatmap",
    "billing",
    "statistics",
    "newapi",
    "cc-switch",
    "local-first",
    "privacy"
  ],
  "homepage": "https://github.com/BioAIEvolu/dsh-token-tally#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BioAIEvolu/dsh-token-tally.git"
  },
  "bugs": "https://github.com/BioAIEvolu/dsh-token-tally/issues",
  "author": "BioAIEvolu",
  "license": "MIT",
  "icon": "icon.svg",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "pricing",
    "docs",
    "docs/images",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "test:isolated": "node --test --test-isolation=none"
  }
}
